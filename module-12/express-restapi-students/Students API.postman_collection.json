    {
      "name": "GET All Students",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const responseData = pm.response.json()",
              "const ids = responseData.map(data => data.id)",
              "pm.collectionVariables.set(\"studentId\", ids[0])",
              "pm.test(\"Response includes id, name, email and program\", function () {",
              "    pm.expect(responseData[0]).to.include.all.keys('id','name','email','program')",
              "})",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
